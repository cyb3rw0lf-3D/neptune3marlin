{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "service-bay-vr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "service-bay-vr",
      // Filled in by the deploy workflow (or `wrangler d1 create service-bay-vr`).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated origins allowed to call the API (the GitHub Pages site and local dev).
    "ALLOWED_ORIGINS": "https://cyb3rw0lf-3d.github.io,http://localhost:4173,http://localhost:5173",
    // Multiplies the per-address rate limits (local end-to-end runs raise it).
    "RATE_LIMIT_SCALE": "1"
  },
  // Daily cleanup: classes idle for a year, old heartbeats and rate-limit counters.
  "triggers": { "crons": ["17 4 * * *"] }
}
